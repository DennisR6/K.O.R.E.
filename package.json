		"@types/p5": "^1.7.7",
		"@types/web": "^0.0.327",
		"typedoc": "^0.28.19",
		"typescript": "~5.9.3",
		"live-server": "^1.2.2"
	},
	"dependencies": {
		"concurrently": "^9.2.1",
		"p5": "^2.2.3"
	},
	"module": "index.ts"
