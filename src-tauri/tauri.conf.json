{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slipstrike",
  "version": "0.0.1",
  "identifier": "com.slipstrike.kore",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4001"
  },
  "app": {
    "windows": [
      {
        "title": "KORE - Slipstrike",
        "width": 800,
        "height": 450,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png"
    ],
    "targets": ["deb"]
  }
}
