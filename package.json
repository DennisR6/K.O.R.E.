{
  "name": "game",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "bun run server.ts",
    "dev": "concurrently \"bun run server.ts\" \"bun run watch:ts\"",
    "build:debug-map": "bun run scripts/buildDebugMap.ts",
    "create:menu-preview": "bun run scripts/createMenuPreviewAsset.ts",
    "mapbuilder:dev": "concurrently \"bun run server.ts\" \"bun run watch:ts\" \"bun run scripts/watchDebugMap.ts\" \"live-server . --port=4002 --open=/src-website/index.html\"",
    "watch:ts": "tsc --watch",
    "serve": "live-server",
    "build": "tsc && cp index.html dist/ && cp -r public dist/",
    "examples:typecheck": "tsc -p examples/tsconfig.json --noEmit",
    "examples:verify": "bun test tests/sdk_examples_ci.test.ts",
    "sdk:build": "bun run scripts/buildSdkBundles.ts",
    "content:release-gate": "bun run scripts/contentReleaseGate.ts",
    "sdk:release-gate": "bun test tests/sdk_only_release_gate.test.ts && bun run examples:typecheck && bun run examples:verify && bun test tests/sdk_migration_cross_system_qualification.test.ts && npx tsc --noEmit && bun run build && bun run test:fast && bun run test:browser:smoke && bun run desktop:build",
    "playtest:build": "bun run build && bun run desktop:build",
    "test": "bun run test:fast",
    "test:unit": "TEST_LANE=unit bun run scripts/testLane.ts",
    "test:integration": "TEST_LANE=integration bun run scripts/testLane.ts",
    "test:integration:fast": "TEST_LANE=integration TEST_PROFILE=fast bun run scripts/testLane.ts",
    "test:qualification": "TEST_LANE=qualification bun run scripts/testLane.ts",
    "test:qualification:all": "TEST_LANE=qualification TEST_PROFILE=all bun run scripts/testLane.ts",
    "test:qualification:blocked": "TEST_LANE=qualification TEST_PROFILE=blocked bun run scripts/testLane.ts",
    "test:qualification:fast": "TEST_LANE=qualification TEST_PROFILE=fast bun run scripts/testLane.ts",
    "test:e2e": "E2E_WORKERS=1 bun run test:browser:full",
    "test:soak": "bun run test:fuzz && bun run test:physics-fuzz",
    "test:soak:full": "bun run test:fuzz:soak && bun run test:physics-fuzz:soak && bun run test:maps:matrix && bun run test:gameplay-matrix && bun run test:gameplay-tournament",
    "test:fast": "bun run test:unit && bun run test:integration:fast && bun run test:qualification:fast",
    "test:performance": "bun run scripts/performanceBaseline.ts check",
    "performance:update": "bun run scripts/performanceBaseline.ts update",
    "test:release": "npx tsc --noEmit && bun run build && bun run test:fast && bun run test:integration && bun run test:qualification && bun run test:ai-replay && bun run test:browser:smoke && bun run examples:typecheck && bun run examples:verify && bun run desktop:build",
    "test:ai-replay": "bun test --timeout 120000 tests/ai_replay_lifecycle.test.ts",
    "test:fuzz": "bun test tests/ai_match_fuzz.test.ts",
    "test:fuzz:rc": "RC_GAME_COUNT=1000 bun test tests/ai_match_fuzz.test.ts",
    "test:fuzz:soak": "RC_GAME_COUNT=5000 bun test tests/ai_match_fuzz.test.ts",
    "test:physics-fuzz": "bun test tests/physics_fuzz.test.ts",
    "test:physics-fuzz:rc": "PHYSICS_FUZZ_CASES=5000 bun test tests/physics_fuzz.test.ts",
    "test:physics-fuzz:soak": "PHYSICS_FUZZ_CASES=25000 bun test tests/physics_fuzz.test.ts",
    "test:gameplay-matrix": "GAMEPLAY_MATRIX=1 bun test tests/gameplay_content_matrix.test.ts",
    "test:maps": "MAP_MATRIX=1 bun test tests/shipped_map_matrix.test.ts",
    "test:maps:matrix": "MAP_MATRIX_FRESH=1 bun test tests/shipped_map_matrix.test.ts",
    "test:gameplay-pacing": "bun test tests/match_length_distribution.test.ts",
    "test:gameplay-tournament": "bun test tests/gameplay_fairness_tournament.test.ts",
    "test:browser:smoke": "playwright test browser_startup",
    "test:browser:ui-debug": "playwright test ui_debug_sandbox",
    "test:browser:audio": "playwright test browser_audio",
    "test:browser:menu-sdk": "playwright test browser_main_menu_sdk",
    "test:browser:hud": "playwright test browser_hud",
    "test:browser:full": "playwright test",
    "test:browser": "bun run test:browser:full",
    "bench:physics": "bun test tests/physics_performance.test.ts",
    "createAssets": "bun run scripts/createAssetPack.ts",
    "desktop": "PKG_CONFIG_PATH=./src-tauri/.pkgconfig:$PKG_CONFIG_PATH tauri dev",
    "desktop:build": "PKG_CONFIG_PATH=./src-tauri/.pkgconfig:$PKG_CONFIG_PATH tauri build",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/p5": "^1.7.7",
    "@types/web": "^0.0.327",
    "concurrently": "^9.2.1",
    "live-server": "^1.2.2",
    "playwright": "^1.62.1",
    "typedoc": "^0.28.19",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@coffeemakerstudio/bean": "git+ssh://git@github.com/coffeemakerstudio/Bean.git#v0.1.0",
    "@coffeemakerstudio/drip": "git+ssh://git@github.com/coffeemakerstudio/Drip.git#v0.1.0",
    "@coffeemakerstudio/roast": "git+ssh://git@github.com/coffeemakerstudio/Roast.git#v0.1.0",
    "p5": "^2.3.0"
  },
  "module": "index.ts"
}
